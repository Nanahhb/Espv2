local function isFriend(player)
    local ok, result = pcall(function()
        return LocalPlayer:IsFriendsWith(player.UserId)
    end)
    return ok and result
end

local function clearPlayer(player)
    if highlights[player] then
        highlights[player]:Destroy()
        highlights[player] = nil
    end
    if tags[player] then
        tags[player]:Destroy()
        tags[player] = nil
    end
end

local function refreshPlayer(player)
    clearPlayer(player)

    if player == LocalPlayer then return end

    local character = player.Character
    if not character then return end

    local friend = isFriend(player)
    local showHighlight =
        (enabled.Friend and friend)
        or enabled.Highlight
        or (enabled.Player and not friend)

    if showHighlight then
        local h = Instance.new("Highlight")
        h.Name = "NanahhbPlayerHighlight"
        h.Adornee = character
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.FillTransparency = 0.72
        h.OutlineTransparency = 0

        if enabled.Friend and friend then
            h.FillColor = LIGHT_PINK
            h.OutlineColor = PINK
        elseif enabled.Highlight then
            h.FillColor = PINK
            h.OutlineColor = DEEP_PINK
        else
            h.FillColor = Color3.fromRGB(255, 235, 245)
            h.OutlineColor = PINK
        end

        h.Parent = character
        highlights[player] = h
    end

    if enabled.Name or (enabled.Player and not friend)
        or (enabled.Friend and friend) then

        local head = character:FindFirstChild("Head")
        if head then
            local tag = Instance.new("BillboardGui")
            tag.Name = "NanahhbNameTag"
            tag.Size = UDim2.fromOffset(220, 38)
            tag.StudsOffset = Vector3.new(0, 2.8, 0)
            tag.AlwaysOnTop = true
            tag.Adornee = head
            tag.Parent = head

            local label = Instance.new("TextLabel")
            label.Size = UDim2.fromScale(1, 1)
            label.BackgroundTransparency = 1
            label.TextColor3 = (enabled.Friend and friend)
                and LIGHT_PINK or DEEP_PINK
            label.TextStrokeColor3 = Color3.fromRGB(100, 45, 70)
            label.TextStrokeTransparency = 0.35
            label.TextScaled = true
            label.Font = Enum.Font.GothamBold

            if friend then
                label.Text = "♥ " .. player.DisplayName
                    .. " (@" .. player.Name .. ")"
            else
                label.Text = player.DisplayName
                    .. " (@" .. player.Name .. ")"
            end

            label.Parent = tag
            tags[player] = tag
        end
    end
end

local function refreshAll()
    for _, player in ipairs(Players:GetPlayers()) do
        refreshPlayer(player)
    end
end

local function updateButton(key)
    local button = buttons[key]
    if not button then return end

    button.Text = features[
        table.find({"Player", "Friend", "Name", "Highlight"}, key)
    ].name .. (enabled[key] and "   ON ✓" or "   OFF")

    button.BackgroundColor3 = enabled[key] and PINK or LIGHT_PINK
end

for index, feature in ipairs(features) do
    local button = Instance.new("TextButton")
    button.Name = feature.key .. "Button"
    button.Size = UDim2.new(1, -24, 0, 43)
    button.Position = UDim2.fromOffset(12, 79 + (index - 1) * 51)
    button.BackgroundColor3 = LIGHT_PINK
    button.Text = feature.name .. "   OFF"
    button.TextColor3 = TEXT
    button.TextSize = 15
    button.Font = Enum.Font.GothamBold
    button.Parent = menu
    corner(button, 12)
    outline(button, PINK, 1)

    buttons[feature.key] = button

    button.Activated:Connect(function()
        enabled[feature.key] = not enabled[feature.key]
        updateButton(feature.key)
        refreshAll()
    end)
end

